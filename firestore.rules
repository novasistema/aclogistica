rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Vehicles / Móviles
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow write: if isValidId(vehicleId);
    }

    // Conductores
    match /drivers/{driverId} {
      allow read: if true;
      allow write: if isValidId(driverId);
    }

    // Hojas de Ruta
    match /routes/{routeId} {
      allow read: if true;
      allow write: if isValidId(routeId);
    }

    // Encomiendas y Remitos (Public lookup permitted for real-time tracking)
    match /packages/{packageId} {
      allow read: if true;
      allow create: if isValidId(packageId);
      allow update: if isValidId(packageId);
      allow delete: if isValidId(packageId);
    }

    // Mantenimiento de Flota
    match /maintenance/{maintenanceId} {
      allow read: if true;
      allow write: if isValidId(maintenanceId);
    }

    // Notificaciones
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isValidId(notificationId);
    }

    // Proveedores registrados
    match /providers/{providerId} {
      allow read: if true;
      allow write: if isValidId(providerId);
    }

    // Solicitudes de retiro de mercadería
    match /pickup_requests/{requestId} {
      allow read: if true;
      allow write: if isValidId(requestId);
    }

    // Reportes de manejo y penalizaciones a choferes
    match /driver_reports/{reportId} {
      allow read: if true;
      allow write: if isValidId(reportId);
    }
  }
}
